## Test suite for the rand package
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as rand

function main()
    test_suite("rand Package Comprehensive Test Suite")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════════
    # 1. Basic Generation & Integer Range
    # ═══════════════════════════════════════════════════════════════
    let raw = rand::next()
    runner_assert(r, raw >= 0, "rand::next() generates non-negative integer")

    let i = 0
    let all_in_range = 1
    while i < 100
        let val = rand::int(10, 20)
        if val < 10 or val > 20
            all_in_range = 0
        end
        i += 1
    end
    runner_assert(r, all_in_range == 1, "rand::int(10, 20) strictly within range across 100 iterations")

    let single = rand::int(5, 5)
    runner_assert_eq(r, single, 5, "rand::int(x, x) returns x when min == max")

    # ═══════════════════════════════════════════════════════════════
    # 2. Float Range & Probabilities
    # ═══════════════════════════════════════════════════════════════
    let f_ok = 1
    i = 0
    while i < 100
        let f = rand::float_range(1.5, 3.5)
        if f < 1.5 or f >= 3.5
            f_ok = 0
        end
        i += 1
    end
    runner_assert(r, f_ok == 1, "rand::float_range(1.5, 3.5) strictly within [min, max)")

    runner_assert_eq(r, rand::chance(0), 0, "rand::chance(0) always returns 0")
    runner_assert_eq(r, rand::chance(100), 1, "rand::chance(100) always returns 1")

    runner_assert_eq(r, rand::bernoulli(0.0), 0, "rand::bernoulli(0.0) returns 0")
    runner_assert_eq(r, rand::bernoulli(1.0), 1, "rand::bernoulli(1.0) returns 1")

    # ═══════════════════════════════════════════════════════════════
    # 3. Statistical Distributions
    # ═══════════════════════════════════════════════════════════════
    let norm_val = rand::normal(100.0, 15.0)
    runner_assert(r, norm_val > 0.0, "rand::normal produces valid float value")

    let exp_val = rand::exponential(2.0)
    runner_assert(r, exp_val >= 0.0, "rand::exponential produces non-negative float")

    let d_ok = 1
    i = 0
    while i < 50
        let roll = rand::die(6)
        if roll < 1 or roll > 6
            d_ok = 0
        end
        i += 1
    end
    runner_assert(r, d_ok == 1, "rand::die(6) produces values strictly within 1..6")

    # ═══════════════════════════════════════════════════════════════
    # 4. Array Sampling & Shuffling
    # ═══════════════════════════════════════════════════════════════
    let fruits = ["apple", "banana", "cherry", "date"]
    let picked = rand::choice(fruits)
    let found = 0
    for fruit in fruits
        if streq(fruit, picked)
            found = 1
        end
    end
    runner_assert(r, found == 1, "rand::choice selects element from source array")

    let sampled = rand::sample(fruits, 2)
    runner_assert_eq(r, len(sampled), 2, "rand::sample(arr, 2) returns 2 items")
    runner_assert_ne(r, sampled[0], sampled[1], "Sampled elements without replacement are distinct")

    let chosen = rand::choices(fruits, 5)
    runner_assert_eq(r, len(chosen), 5, "rand::choices(arr, 5) returns 5 items with replacement")

    let original = [1, 2, 3, 4, 5]
    let shuf = rand::shuffled(original)
    runner_assert_eq(r, len(shuf), 5, "rand::shuffled preserves array length")

    let weighted_items = ["common", "rare"]
    let weighted_weights = [1000, 0] # rare has weight 0
    let w_pick = rand::weighted_choice(weighted_items, weighted_weights)
    runner_assert_str_eq(r, w_pick, "common", "rand::weighted_choice respects 0-weight item")

    # ═══════════════════════════════════════════════════════════════
    # 5. String Generation
    # ═══════════════════════════════════════════════════════════════
    let s_alpha = rand::alphanumeric(16)
    runner_assert_eq(r, len(s_alpha), 16, "rand::alphanumeric(16) generates length 16")

    let s_digits = rand::digits(10)
    runner_assert_eq(r, len(s_digits), 10, "rand::digits(10) generates length 10")

    let s_hex = rand::hex(8)
    runner_assert_eq(r, len(s_hex), 8, "rand::hex(8) generates length 8")

    let s_custom = rand::string(5, "ABC")
    runner_assert_eq(r, len(s_custom), 5, "rand::string from custom charset")

    let b_bytes = rand::bytes(16)
    runner_assert_eq(r, len(b_bytes), 16, "rand::bytes(16) generates 16 bytes")
    let test_rng = rand::new(42)
    let b_rng = rand::rng_bytes(test_rng, 10)
    runner_assert_eq(r, len(b_rng), 10, "rand::rng_bytes(rng, 10) generates 10 bytes")

    # ═══════════════════════════════════════════════════════════════
    # 6. Deterministic Seeding & Multiple Engines
    # ═══════════════════════════════════════════════════════════════
    let rng_a = rand::new(42, 2) # SplitMix64
    let val_a1 = rand::rng_int(rng_a, 1, 1000)
    let val_a2 = rand::rng_int(rng_a, 1, 1000)

    let rng_b = rand::new(42, 2) # Same seed and algorithm
    let val_b1 = rand::rng_int(rng_b, 1, 1000)
    let val_b2 = rand::rng_int(rng_b, 1, 1000)

    runner_assert_eq(r, val_a1, val_b1, "Deterministic PRNG: first value identical with same seed")
    runner_assert_eq(r, val_a2, val_b2, "Deterministic PRNG: second value identical with same seed")

    let rng_xorshift = rand::new(99, 1) # Xorshift64
    let val_x = rand::rng_int(rng_xorshift, 1, 100)
    runner_assert(r, val_x >= 1 and val_x <= 100, "Xorshift64 engine produces in-range values")

    let rng_pcg = rand::new(123, 3) # PCG32
    let val_p = rand::rng_int(rng_pcg, 1, 100)
    runner_assert(r, val_p >= 1 and val_p <= 100, "PCG32 engine produces in-range values")

    # ═══════════════════════════════════════════════════════════════
    # 7. Idiomatic Rng Struct Methods & RngAlgorithm Enum
    # ═══════════════════════════════════════════════════════════════
    let rng_m = rand::new(777, rand::RngAlgorithm.SplitMix64)
    let m_int = rng_m.int(10, 50)
    runner_assert(r, m_int >= 10 and m_int <= 50, "rng.int() struct method works")

    let m_flt = rng_m.next_float()
    runner_assert(r, m_flt >= 0.0 and m_flt < 1.0, "rng.next_float() struct method works")

    let m_choice = rng_m.choice(["x", "y", "z"])
    runner_assert(r, m_choice in ["x", "y", "z"], "rng.choice() struct method and 'in' operator work")

    let m_bytes = rng_m.bytes(4)
    runner_assert_eq(r, len(m_bytes), 4, "rng.bytes() struct method works")

    let m_choices = rng_m.choices(["red", "blue"], 3)
    runner_assert_eq(r, len(m_choices), 3, "rng.choices() struct method works")

    let m_sample = rng_m.sample(["red", "green", "blue"], 2)
    runner_assert_eq(r, len(m_sample), 2, "rng.sample() struct method works")

    let m_shuffled = rng_m.shuffled([10, 20, 30])
    runner_assert_eq(r, len(m_shuffled), 3, "rng.shuffled() struct method works")

    let m_weighted = rng_m.weighted_choice(["gold", "silver"], [100, 0])
    runner_assert_str_eq(r, m_weighted, "gold", "rng.weighted_choice() struct method works")

    let m_die = rng_m.die(12)
    runner_assert(r, m_die >= 1 and m_die <= 12, "rng.die() struct method works")

    let m_bern = rng_m.bernoulli(1.0)
    runner_assert_eq(r, m_bern, 1, "rng.bernoulli() struct method works")

    let m_bin = rng_m.binomial(4, 1.0)
    runner_assert_eq(r, m_bin, 4, "rng.binomial() struct method works")

    let m_chance = rng_m.chance(100)
    runner_assert_eq(r, m_chance, 1, "rng.chance() struct method works")

    # ═══════════════════════════════════════════════════════════════
    # 8. Instance Helpers for Strings and Distributions
    # ═══════════════════════════════════════════════════════════════
    let h_alpha = rand::rng_alphanumeric(test_rng, 12)
    runner_assert_eq(r, len(h_alpha), 12, "rand::rng_alphanumeric generates 12 chars")

    let h_digits = rand::rng_digits(test_rng, 8)
    runner_assert_eq(r, len(h_digits), 8, "rand::rng_digits generates 8 digits")

    let h_hex = rand::rng_hex(test_rng, 6)
    runner_assert_eq(r, len(h_hex), 6, "rand::rng_hex generates 6 chars")

    let h_hex_up = rand::rng_hex_upper(test_rng, 6)
    runner_assert_eq(r, len(h_hex_up), 6, "rand::rng_hex_upper generates 6 chars")

    let h_str = rand::rng_str_random(test_rng, 5, "ABC")
    runner_assert_eq(r, len(h_str), 5, "rand::rng_str_random generates custom string")

    let h_choices = rand::rng_choices(test_rng, ["x", "y"], 4)
    runner_assert_eq(r, len(h_choices), 4, "rand::rng_choices selects 4 elements")

    let h_sample = rand::rng_sample(test_rng, ["x", "y", "z"], 2)
    runner_assert_eq(r, len(h_sample), 2, "rand::rng_sample samples 2 elements")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
