# Comprehensive Test Suite for rand package
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as rand

function main()
    test_suite("rand Package Comprehensive Test Suite")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════════
    # 1. Basic Generation & Integer Range
    # ═══════════════════════════════════════════════════════════════
    let raw = rand::next()
    runner_assert(r, raw >= 0, "rand::next() generates non-negative integer")

    let i = 0
    let all_in_range = 1
    while i < 100
        let val = rand::int(10, 20)
        if val < 10 or val > 20
            all_in_range = 0
        end
        i += 1
    end
    runner_assert(r, all_in_range == 1, "rand::int(10, 20) strictly within range across 100 iterations")

    let single = rand::int(5, 5)
    runner_assert_eq(r, single, 5, "rand::int(x, x) returns x when min == max")

    # ═══════════════════════════════════════════════════════════════
    # 2. Float Range & Probabilities
    # ═══════════════════════════════════════════════════════════════
    let f_ok = 1
    i = 0
    while i < 100
        let f = rand::float_range(1.5, 3.5)
        if f < 1.5 or f >= 3.5
            f_ok = 0
        end
        i += 1
    end
    runner_assert(r, f_ok == 1, "rand::float_range(1.5, 3.5) strictly within [min, max)")

    runner_assert_eq(r, rand::chance(0), 0, "rand::chance(0) always returns 0")
    runner_assert_eq(r, rand::chance(100), 1, "rand::chance(100) always returns 1")

    runner_assert_eq(r, rand::bernoulli(0.0), 0, "rand::bernoulli(0.0) returns 0")
    runner_assert_eq(r, rand::bernoulli(1.0), 1, "rand::bernoulli(1.0) returns 1")

    # ═══════════════════════════════════════════════════════════════
    # 3. Die Rolling
    # ═══════════════════════════════════════════════════════════════
    let d_ok = 1
    i = 0
    while i < 50
        let roll = rand::die(6)
        if roll < 1 or roll > 6
            d_ok = 0
        end
        i += 1
    end
    runner_assert(r, d_ok == 1, "rand::die(6) produces values strictly within 1..6")

    # ═══════════════════════════════════════════════════════════════
    # 4. Array Sampling & Shuffling
    # ═══════════════════════════════════════════════════════════════
    let fruits = ["apple", "banana", "cherry", "date"]
    let picked = rand::choice(fruits)
    let found = 0
    for fruit in fruits
        if streq(fruit, picked)
            found = 1
        end
    end
    runner_assert(r, found == 1, "rand::choice selects element from source array")

    let sampled = rand::sample(fruits, 2)
    runner_assert_eq(r, len(sampled), 2, "rand::sample(arr, 2) returns 2 items")
    runner_assert_ne(r, sampled[0], sampled[1], "Sampled elements without replacement are distinct")

    let chosen = rand::choices(fruits, 5)
    runner_assert_eq(r, len(chosen), 5, "rand::choices(arr, 5) returns 5 items with replacement")

    let original = [1, 2, 3, 4, 5]
    let shuf = rand::shuffled(original)
    runner_assert_eq(r, len(shuf), 5, "rand::shuffled preserves array length")

    let weighted_items = ["common", "rare"]
    let weighted_weights = [1000, 0] # rare has weight 0
    let w_pick = rand::weighted_choice(weighted_items, weighted_weights)
    runner_assert_str_eq(r, w_pick, "common", "rand::weighted_choice respects 0-weight item")

    # ═══════════════════════════════════════════════════════════════
    # 5. String Generation
    # ═══════════════════════════════════════════════════════════════
    let s_alpha = rand::alphanumeric(16)
    runner_assert_eq(r, len(s_alpha), 16, "rand::alphanumeric(16) generates length 16")

    let s_digits = rand::digits(10)
    runner_assert_eq(r, len(s_digits), 10, "rand::digits(10) generates length 10")

    let s_hex = rand::hex(8)
    runner_assert_eq(r, len(s_hex), 8, "rand::hex(8) generates length 8")

    let s_custom = rand::string(5, "ABC")
    runner_assert_eq(r, len(s_custom), 5, "rand::string from custom charset")

    let b_bytes = rand::bytes(16)
    runner_assert_eq(r, len(b_bytes), 16, "rand::bytes(16) generates 16 bytes")
    let test_rng = rand::new(42)
    let b_rng = rand::rng_bytes(test_rng, 10)
    runner_assert_eq(r, len(b_rng), 10, "rand::rng_bytes(rng, 10) generates 10 bytes")
    let b_legacy = rand::rand_bytes(8)
    runner_assert_eq(r, len(b_legacy), 8, "rand::rand_bytes(8) legacy generates 8 bytes")

    # ═══════════════════════════════════════════════════════════════
    # 6. Unique Identifiers (UUID v4, UUID v7, ULID, NanoID)
    # ═══════════════════════════════════════════════════════════════
    let u4 = rand::uuid_v4()
    runner_assert_eq(r, len(u4), 36, "UUID v4 is exactly 36 characters")
    runner_assert_str_eq(r, char_at(u4, 8), "-", "UUID v4 hyphen at index 8")
    runner_assert_str_eq(r, char_at(u4, 13), "-", "UUID v4 hyphen at index 13")
    runner_assert_str_eq(r, char_at(u4, 14), "4", "UUID v4 version digit is '4'")
    runner_assert_str_eq(r, char_at(u4, 18), "-", "UUID v4 hyphen at index 18")
    runner_assert_str_eq(r, char_at(u4, 23), "-", "UUID v4 hyphen at index 23")

    let u4_simple = rand::uuid_v4_simple()
    runner_assert_eq(r, len(u4_simple), 32, "UUID v4 simple is exactly 32 characters")

    let u7 = rand::uuid_v7()
    runner_assert_eq(r, len(u7), 36, "UUID v7 is exactly 36 characters")
    runner_assert_str_eq(r, char_at(u7, 14), "7", "UUID v7 version digit is '7'")

    let u_ulid = rand::ulid()
    runner_assert_eq(r, len(u_ulid), 26, "ULID is exactly 26 characters")

    let nid = rand::nanoid(12)
    runner_assert_eq(r, len(nid), 12, "NanoID generates specified size")

    # ═══════════════════════════════════════════════════════════════
    # 7. Deterministic Seeding & Multiple Engines
    # ═══════════════════════════════════════════════════════════════
    let rng_a = rand::new_rng(42, 2) # SplitMix64
    let val_a1 = rand::uniform_int(rng_a, 1, 1000)
    let val_a2 = rand::uniform_int(rng_a, 1, 1000)

    let rng_b = rand::new_rng(42, 2) # Same seed and algorithm
    let val_b1 = rand::uniform_int(rng_b, 1, 1000)
    let val_b2 = rand::uniform_int(rng_b, 1, 1000)

    runner_assert_eq(r, val_a1, val_b1, "Deterministic PRNG: first value identical with same seed")
    runner_assert_eq(r, val_a2, val_b2, "Deterministic PRNG: second value identical with same seed")

    let rng_xorshift = rand::new_rng(99, 1) # Xorshift64
    let val_x = rand::uniform_int(rng_xorshift, 1, 100)
    runner_assert(r, val_x >= 1 and val_x <= 100, "Xorshift64 engine produces in-range values")

    let rng_pcg = rand::new_rng(123, 3) # PCG32
    let val_p = rand::uniform_int(rng_pcg, 1, 100)
    runner_assert(r, val_p >= 1 and val_p <= 100, "PCG32 engine produces in-range values")

    # ═══════════════════════════════════════════════════════════════
    # 8. Legacy Compatibility Aliases (std/rand Parity)
    # ═══════════════════════════════════════════════════════════════
    let leg_int = rand::rand_int(1, 10)
    runner_assert(r, leg_int >= 1 and leg_int <= 10, "Legacy alias: rand_int works")

    let leg_shuf = rand::rand_shuffled([10, 20, 30])
    runner_assert_eq(r, len(leg_shuf), 3, "Legacy alias: rand_shuffled works")

    let leg_ulid = rand::ulid_generate()
    runner_assert_eq(r, len(leg_ulid), 26, "Legacy alias: ulid_generate works")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
