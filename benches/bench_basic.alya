# Benchmark suite for rand
import "std/bench"
import "../src/lib.alya" as rand

function main()
    let runner = bench_runner("rand Micro-Benchmarks")

    # 1. Global PRNG next()
    bench_start(runner, 1000000)
    let i = 0
    while i < 1000000
        rand::next()
        i += 1
    end
    bench_stop(runner, "rand::next() 1M calls")

    # 2. Integer Range Generation
    bench_start(runner, 500000)
    let j = 0
    while j < 500000
        rand::int(1, 100)
        j += 1
    end
    bench_stop(runner, "rand::int(1, 100) 500k calls")

    # 3. Dedicated Xorshift64 Instance
    let rng_xor = rand::new(12345, rand::RngAlgorithm.XorShift64)
    bench_start(runner, 500000)
    let k = 0
    while k < 500000
        rand::rng_int(rng_xor, 1, 100)
        k += 1
    end
    bench_stop(runner, "Xorshift64 rng_int 500k calls")

    # 4. Dedicated SplitMix64 Instance
    let rng_sm = rand::new(12345, rand::RngAlgorithm.SplitMix64)
    bench_start(runner, 500000)
    let m = 0
    while m < 500000
        rand::rng_int(rng_sm, 1, 100)
        m += 1
    end
    bench_stop(runner, "SplitMix64 rng_int 500k calls")

    # 5. Alphanumeric String Generation
    bench_start(runner, 50000)
    let s = 0
    while s < 50000
        rand::alphanumeric(16)
        s += 1
    end
    bench_stop(runner, "rand::alphanumeric(16) 50k calls")

    bench_summary(runner)
end

main()
