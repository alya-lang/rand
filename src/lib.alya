# Modern, fast pseudo-random number generator (PRNG), statistical distributions,
# and sampling toolkit for Alya
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./types.alya"
import "./core/algorithms.alya"
import "./core/distributions.alya"
import "./core/sampling.alya"
import "./core/strings.alya"

# ═══════════════════════════════════════════════════════════════
# Global PRNG State Management
# ═══════════════════════════════════════════════════════════════

## Seeds the global PRNG with an integer seed.
pub function seed(s)
    rand_seed(s)
end

## Auto-seeds the global PRNG with system time and high-resolution timer.
pub function auto_seed()
    let s = (time() * 1000) + (clock_ms() % 1000) + rand()
    rand_seed(s)
end

## Creates a new independent RNG instance with an optional seed and algorithm.
pub function new(seed = 0, algorithm = 2) -> Rng
    return rng_new(seed, algorithm)
end

# ═══════════════════════════════════════════════════════════════
# Top-Level Global Convenience Facade
# ═══════════════════════════════════════════════════════════════

## Generates a pseudo-random non-negative integer in [0, 2147483647] using the global PRNG.
pub function next()
    let r = rand()
    if r < 0
        r = 0 - r
    end
    return bit_and(r, 2147483647)
end

## Generates a random integer in the inclusive range [min_val, max_val].
pub function int(min_val, max_val)
    if min_val >= max_val
        return min_val
    end
    let r = next()
    if r < 0
        r = 0 - r
    end
    let range = (max_val - min_val) + 1
    let rem = r % range
    if rem < 0
        rem = 0 - rem
    end
    let res = min_val + rem
    if res > max_val
        res = max_val
    end
    return res
end

## Generates a random float in the half-open range [0.0, 1.0).
pub function rand_float()
    let r = next() % 1000000000
    return r / 1000000000.0
end

## Generates a random float in the half-open range [min_val, max_val).
pub function float_range(min_val, max_val)
    if min_val >= max_val
        return min_val
    end
    let f = rand_float()
    return min_val + (f * (max_val - min_val))
end

## Returns 1 or 0 with 50% probability.
pub function bool()
    return next() % 2
end

## Returns 1 if an event with percentage pct (0..100) occurs, else 0.
pub function chance(pct)
    if pct <= 0
        return 0
    end
    if pct >= 100
        return 1
    end
    return (next() % 100) < pct
end

## Simulates a Bernoulli trial with success probability p (0.0 <= p <= 1.0).
pub function bernoulli(p)
    if p <= 0.0
        return 0
    end
    if p >= 1.0
        return 1
    end
    let sample = rand_float()
    if sample < p
        return 1
    else
        return 0
    end
end

## Simulates a Binomial experiment with n trials and success probability p.
pub function binomial(n, p)
    if n <= 0 or p <= 0.0
        return 0
    end
    let successes = 0
    let i = 0
    while i < n
        successes += bernoulli(p)
        i += 1
    end
    return successes
end

## Generates a normally distributed random float (Gaussian) using Box-Muller transform.
pub function normal(mean = 0.0, std_dev = 1.0)
    let r1 = next() % 1000000000
    if r1 <= 0
        r1 = 1
    end
    let u1 = r1 / 1000000000.0

    let r2 = next() % 1000000000
    let u2 = r2 / 1000000000.0
    let two_pi = 6.283185307179586

    let r = native_sqrt(0.0 - 2.0 * native_log(u1))
    let theta = two_pi * u2
    let z0 = r * native_cos(theta)
    return mean + (z0 * std_dev)
end

## Generates an exponentially distributed random float with given rate (lambda).
pub function exponential(rate = 1.0)
    if rate <= 0.0
        return 0.0
    end
    let r = next() % 1000000000
    if r <= 0
        r = 1
    end
    let u = r / 1000000000.0
    return (0.0 - native_log(1.0 - u)) / (rate * 1.0)
end

## Simulates rolling an n-sided die (returns integer in 1..sides).
pub function die(sides = 6)
    if sides <= 1
        return 1
    end
    return int(1, sides)
end

## Selects a single randomly chosen element from array arr.
pub function choice(arr)
    let n = len(arr)
    if n == 0
        return null
    end
    let idx = int(0, n - 1)
    if idx < 0
        idx = 0
    elif idx >= n
        idx = n - 1
    end
    return arr[idx]
end

## Selects count elements from array arr with replacement.
pub function choices(arr, count) -> array
    let n = len(arr)
    if count <= 0 or n == 0
        return []
    end
    let res = []
    let i = 0
    while i < count
        res.push(choice(arr))
        i += 1
    end
    return res
end

## Performs an in-place Fisher-Yates shuffle on array arr.
pub function shuffle(arr) -> array
    let n = len(arr)
    if n <= 1
        return arr
    end
    let i = n - 1
    while i > 0
        let j = int(0, i)
        if j < 0
            j = 0
        elif j > i
            j = i
        end
        let temp = arr[i]
        arr[i] = arr[j]
        arr[j] = temp
        i -= 1
    end
    return arr
end

## Returns a new shuffled copy of array arr.
pub function shuffled(arr) -> array
    let copy = []
    for item in arr
        copy.push(item)
    end
    shuffle(copy)
    return copy
end

## Samples count distinct elements from array arr without replacement.
pub function sample(arr, count) -> array
    let n = len(arr)
    if count <= 0 or n == 0
        return []
    end
    if count >= n
        return shuffled(arr)
    end
    let pool = shuffled(arr)
    let pool_len = len(pool)
    let limit = if count < pool_len then count else pool_len
    let res = []
    let i = 0
    while i < limit
        res.push(pool[i])
        i += 1
    end
    return res
end

## Selects an item from items according to relative non-negative weights.
pub function weighted_choice(items, weights)
    let n = len(items)
    if n == 0
        return null
    end
    let w_len = len(weights)
    if w_len < n
        return choice(items)
    end

    let total_weight = 0
    for w in weights
        if w > 0
            total_weight += w
        end
    end

    if total_weight <= 0
        return choice(items)
    end

    let threshold = int(1, total_weight)
    let accum = 0
    let i = 0
    while i < n
        let w = weights[i]
        if w > 0
            accum += w
            if threshold <= accum
                return items[i]
            end
        end
        i += 1
    end

    return items[0]
end

## Generates a random string of length n from custom charset.
pub function string(n, charset)
    let clen = len(charset)
    if clen == 0 or n <= 0
        return ""
    end
    let res = ""
    let i = 0
    while i < n
        let idx = int(0, clen - 1)
        res += char_at(charset, idx)
        i += 1
    end
    return res
end

## Generates an alphanumeric string of length n ([a-zA-Z0-9]).
pub function alphanumeric(n)
    let chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    return string(n, chars)
end

## Generates a numeric digits string of length n ([0-9]).
pub function digits(n)
    let digs = "0123456789"
    return string(n, digs)
end

## Generates a lowercase hexadecimal string of length n ([0-9a-f]).
pub function hex(n)
    let h = "0123456789abcdef"
    return string(n, h)
end

## Generates an uppercase hexadecimal string of length n ([0-9A-F]).
pub function hex_upper(n)
    let h = "0123456789ABCDEF"
    return string(n, h)
end

## Generates a printable ASCII string of length n.
pub function ascii(n)
    let chars = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_ abcdefghijklmnopqrstuvwxyz{|}~"
    return string(n, chars)
end

## Generates an array of count random byte integers (0..255).
pub function bytes(count) -> array
    let bytes_arr = []
    let i = 0
    while i < count
        bytes_arr.push(int(0, 255))
        i += 1
    end
    return bytes_arr
end

# ═══════════════════════════════════════════════════════════════
# Instance-Parameterized Functions (Operate on a specific Rng)
# ═══════════════════════════════════════════════════════════════

## Generates a random integer in [min_val, max_val] using the given RNG instance.
pub function rng_int(rng, min_val, max_val)
    return dist_uniform_int(rng, min_val, max_val)
end

## Generates a random float in [0.0, 1.0) using the given RNG instance.
pub function rng_float(rng)
    return dist_float(rng)
end

## Generates a random float in [min_val, max_val) using the given RNG instance.
pub function rng_float_range(rng, min_val, max_val)
    return dist_uniform_float(rng, min_val, max_val)
end

## Returns 1 or 0 with 50% probability using the given RNG instance.
pub function rng_bool(rng)
    return dist_uniform_int(rng, 0, 1)
end

## Returns 1 if event with percentage pct occurs using the given RNG instance, else 0.
pub function rng_chance(rng, pct)
    return dist_chance(rng, pct)
end

## Simulates a Bernoulli trial with success probability p using the given RNG instance.
pub function rng_bernoulli(rng, p)
    return dist_bernoulli(rng, p)
end

## Simulates a Binomial experiment with n trials and probability p using the given RNG instance.
pub function rng_binomial(rng, n, p)
    return dist_binomial(rng, n, p)
end

## Generates a normally distributed random float (Gaussian) using the given RNG instance.
pub function rng_normal(rng, mean = 0.0, std_dev = 1.0)
    return dist_normal(rng, mean, std_dev)
end

## Generates an exponentially distributed random float using the given RNG instance.
pub function rng_exponential(rng, rate = 1.0)
    return dist_exponential(rng, rate)
end

## Simulates rolling an n-sided die using the given RNG instance.
pub function rng_die(rng, sides = 6)
    return dist_die_roll(rng, sides)
end

## Selects a single randomly chosen element from array arr using the given RNG instance.
pub function rng_choice(rng, arr)
    return sample_choice(rng, arr)
end

## Selects count elements from array arr with replacement using the given RNG instance.
pub function rng_choices(rng, arr, count) -> array
    return sample_choices(rng, arr, count)
end

## Performs an in-place Fisher-Yates shuffle on array arr using the given RNG instance.
pub function rng_shuffle(rng, arr) -> array
    return sample_shuffle(rng, arr)
end

## Returns a new shuffled copy of array arr using the given RNG instance.
pub function rng_shuffled(rng, arr) -> array
    return sample_shuffled(rng, arr)
end

## Samples count distinct elements from array arr without replacement using the given RNG instance.
pub function rng_sample(rng, arr, count) -> array
    return sample_sample(rng, arr, count)
end

## Selects an item according to relative non-negative weights using the given RNG instance.
pub function rng_weighted_choice(rng, items, weights)
    return sample_weighted_choice(rng, items, weights)
end

## Generates an array of count random byte integers (0..255) using the given RNG instance.
pub function rng_bytes(rng, count) -> array
    return str_bytes(rng, count)
end

## Generates a random string of length n from custom charset using the given RNG instance.
pub function rng_str_random(rng, n, charset)
    return str_random(rng, n, charset)
end

## Generates an alphanumeric string of length n using the given RNG instance.
pub function rng_alphanumeric(rng, n)
    return str_alphanumeric(rng, n)
end

## Generates a numeric digits string of length n using the given RNG instance.
pub function rng_digits(rng, n)
    return str_digits(rng, n)
end

## Generates a lowercase hexadecimal string of length n using the given RNG instance.
pub function rng_hex(rng, n)
    return str_hex(rng, n)
end

## Generates an uppercase hexadecimal string of length n using the given RNG instance.
pub function rng_hex_upper(rng, n)
    return str_hex_upper(rng, n)
end

## Generates a printable ASCII string of length n using the given RNG instance.
pub function rng_ascii(rng, n)
    return str_ascii(rng, n)
end

# ═══════════════════════════════════════════════════════════════
# Idiomatic Struct Methods on Rng
# ═══════════════════════════════════════════════════════════════

## Advances RNG state and returns a non-negative pseudo-random integer.
pub function Rng.next(self)
    return rng_next(self)
end

## Generates a random integer in inclusive range [min_val, max_val].
pub function Rng.int(self, min_val, max_val)
    return rng_int(self, min_val, max_val)
end

## Generates a random float in [0.0, 1.0).
pub function Rng.float(self)
    return rng_float(self)
end

## Alias for Rng.float().
pub function Rng.next_float(self)
    return rng_float(self)
end

## Alias for Rng.float().
pub function Rng.rand_float(self)
    return rng_float(self)
end

## Generates a random float in [min_val, max_val).
pub function Rng.float_range(self, min_val, max_val)
    return rng_float_range(self, min_val, max_val)
end

## Returns 1 or 0 with 50% probability.
pub function Rng.bool(self)
    return rng_bool(self)
end

## Returns 1 if event with percentage pct occurs, else 0.
pub function Rng.chance(self, pct)
    return rng_chance(self, pct)
end

## Simulates a Bernoulli trial with success probability p.
pub function Rng.bernoulli(self, p)
    return rng_bernoulli(self, p)
end

## Simulates a Binomial experiment with n trials and probability p.
pub function Rng.binomial(self, n, p)
    return rng_binomial(self, n, p)
end

## Generates a normally distributed random float (Gaussian).
pub function Rng.normal(self, mean = 0.0, std_dev = 1.0)
    return rng_normal(self, mean, std_dev)
end

## Generates an exponentially distributed random float.
pub function Rng.exponential(self, rate = 1.0)
    return rng_exponential(self, rate)
end

## Simulates rolling an n-sided die.
pub function Rng.die(self, sides = 6)
    return rng_die(self, sides)
end

## Selects a single randomly chosen element from array arr.
pub function Rng.choice(self, arr)
    return rng_choice(self, arr)
end

## Selects count elements from array arr with replacement.
pub function Rng.choices(self, arr, count) -> array
    return rng_choices(self, arr, count)
end

## Performs an in-place Fisher-Yates shuffle on array arr.
pub function Rng.shuffle(self, arr) -> array
    return rng_shuffle(self, arr)
end

## Returns a new shuffled copy of array arr.
pub function Rng.shuffled(self, arr) -> array
    return rng_shuffled(self, arr)
end

## Samples count distinct elements from array arr without replacement.
pub function Rng.sample(self, arr, count) -> array
    return rng_sample(self, arr, count)
end

## Selects an item according to relative non-negative weights.
pub function Rng.weighted_choice(self, items, weights)
    return rng_weighted_choice(self, items, weights)
end

## Generates an array of count random byte integers (0..255).
pub function Rng.bytes(self, count) -> array
    return rng_bytes(self, count)
end
