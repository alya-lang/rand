# Types and data structures for rand
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# Public enumeration for PRNG engine algorithms (exported via pub)
pub enum RngAlgorithm
    XorShift64 = 1,
    SplitMix64 = 2,
    Pcg32 = 3,
    Lcg = 4
end


# Pseudo-Random Number Generator State
pub struct Rng
    algorithm,
    state0,
    state1,
    inc
end

# Weighted item structure for weighted choice selections
pub struct WeightedItem
    item,
    weight
end
