# Types and data structures for rand
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# Public enumeration for PRNG engine algorithms (exported via pub)
pub enum RngAlgorithm
    XorShift64 = 1,
    SplitMix64 = 2,
    Pcg32 = 3,
    Lcg = 4
end

# PRNG Algorithm Selectors (Backward Compatible)
pub let ALG_XORSHIFT64 = 1
pub let ALG_SPLITMIX64 = 2
pub let ALG_PCG32      = 3
pub let ALG_LCG        = 4

# Pseudo-Random Number Generator State
pub struct Rng
    algorithm,
    state0,
    state1,
    inc
end

# Weighted item structure for weighted choice selections
pub struct WeightedItem
    item,
    weight
end
