# Unique Identifier Generation Utilities (UUID v4, UUID v7, ULID, NanoID)
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/time"
import "./distributions.alya"
import "./strings.alya"

# Generates a 36-character RFC 4122 compliant UUID Version 4 string
function id_uuid_v4(rng)
    let hex = "0123456789abcdef"
    let variant_chars = "89ab"
    let res = ""

    # Part 1: 8 hex chars
    let i = 0
    while i < 8
        res = res + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end
    res = res + "-"

    # Part 2: 4 hex chars
    i = 0
    while i < 4
        res = res + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end
    res = res + "-"

    # Part 3: 4 hex chars with version '4'
    res = res + "4"
    i = 0
    while i < 3
        res = res + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end
    res = res + "-"

    # Part 4: 4 hex chars with variant [8, 9, a, b]
    res = res + char_at(variant_chars, dist_uniform_int(rng, 0, 3))
    i = 0
    while i < 3
        res = res + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end
    res = res + "-"

    # Part 5: 12 hex chars
    i = 0
    while i < 12
        res = res + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end

    return res
end

# Generates a 32-character UUID Version 4 string without hyphens
function id_uuid_v4_simple(rng)
    let hex = "0123456789abcdef"
    let variant_chars = "89ab"
    let res = ""

    let i = 0
    while i < 12
        res = res + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end

    # Version 4
    res = res + "4"
    i = 0
    while i < 3
        res = res + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end

    # Variant
    res = res + char_at(variant_chars, dist_uniform_int(rng, 0, 3))
    i = 0
    while i < 15
        res = res + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end

    return res
end

# Internal helper to encode 48-bit millisecond timestamp into 12 hexadecimal characters
function _uuid_v7_hex_time(t)
    let hex = "0123456789abcdef"
    let res = ""
    let divisor = 17592186044416 # 16^11
    let i = 0
    while i < 12
        let nibble = (t / divisor) % 16
        res = res + char_at(hex, nibble)
        divisor = divisor / 16
        i += 1
    end
    return res
end

# Generates a 36-character RFC 9562 compliant UUID Version 7 string for a given millisecond timestamp
function id_uuid_v7_at(rng, timestamp_ms)
    let hex = "0123456789abcdef"
    let variant_chars = "89ab"
    let time_hex = _uuid_v7_hex_time(timestamp_ms)

    let p1 = substring(time_hex, 0, 8)
    let p2 = substring(time_hex, 8, 4)

    let p3 = "7"
    let i = 0
    while i < 3
        p3 = p3 + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end

    let p4 = char_at(variant_chars, dist_uniform_int(rng, 0, 3))
    i = 0
    while i < 3
        p4 = p4 + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end

    let p5 = ""
    i = 0
    while i < 12
        p5 = p5 + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end

    return p1 + "-" + p2 + "-" + p3 + "-" + p4 + "-" + p5
end

# Generates a 36-character RFC 9562 compliant UUID Version 7 string using current system time
function id_uuid_v7(rng)
    let now_ms = (time() * 1000) + (clock_ms() % 1000)
    return id_uuid_v7_at(rng, now_ms)
end

# Generates a 32-character UUID Version 7 string without hyphens for a given millisecond timestamp
function id_uuid_v7_simple_at(rng, timestamp_ms)
    let hex = "0123456789abcdef"
    let variant_chars = "89ab"
    let time_hex = _uuid_v7_hex_time(timestamp_ms)

    let res = time_hex + "7"
    let i = 0
    while i < 3
        res = res + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end

    res = res + char_at(variant_chars, dist_uniform_int(rng, 0, 3))
    i = 0
    while i < 3
        res = res + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end

    i = 0
    while i < 12
        res = res + char_at(hex, dist_uniform_int(rng, 0, 15))
        i += 1
    end

    return res
end

# Generates a 32-character UUID Version 7 string without hyphens using current system time
function id_uuid_v7_simple(rng)
    let now_ms = (time() * 1000) + (clock_ms() % 1000)
    return id_uuid_v7_simple_at(rng, now_ms)
end

# Internal helper to encode 48-bit millisecond timestamp into 10 Crockford Base32 characters
function _ulid_encode_time(t)
    let chars = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
    let res = ""
    let divisor = 35184372088832 # 32^9
    let i = 0
    while i < 10
        let idx = (t / divisor) % 32
        res = res + char_at(chars, idx)
        divisor = divisor / 32
        i += 1
    end
    return res
end

# Generates a 26-character ULID for a specific timestamp in milliseconds
function id_ulid_at(rng, timestamp_ms)
    let chars = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
    let time_part = _ulid_encode_time(timestamp_ms)

    let rand_part = ""
    let i = 0
    while i < 16
        let idx = dist_uniform_int(rng, 0, 31)
        rand_part = rand_part + char_at(chars, idx)
        i += 1
    end

    return time_part + rand_part
end

# Generates a 26-character ULID using current system time and 80-bit randomness
function id_ulid(rng)
    let now_ms = (time() * 1000) + (clock_ms() % 1000)
    return id_ulid_at(rng, now_ms)
end

# Generates a compact, URL-friendly NanoID string
function id_nanoid(rng, size = 21, alphabet = "")
    if len(alphabet) == 0
        alphabet = "_~0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    end
    return str_random(rng, size, alphabet)
end
