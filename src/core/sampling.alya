# Array & Collection Sampling Utilities for rand package
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./distributions.alya"

## Returns a randomly selected element from array arr.
pub function sample_choice(rng, arr)
    let n = len(arr)
    if n == 0
        return null
    end
    let idx = dist_uniform_int(rng, 0, n - 1)
    if idx < 0
        idx = 0
    elif idx >= n
        idx = n - 1
    end
    return arr[idx]
end

## Performs an in-place Fisher-Yates shuffle of array arr.
pub function sample_shuffle(rng, arr) -> array
    let n = len(arr)
    if n <= 1
        return arr
    end
    let i = n - 1
    while i > 0
        let j = dist_uniform_int(rng, 0, i)
        if j < 0
            j = 0
        elif j > i
            j = i
        end
        let temp = arr[i]
        arr[i] = arr[j]
        arr[j] = temp
        i -= 1
    end
    return arr
end

## Returns a new shuffled copy of array arr.
pub function sample_shuffled(rng, arr) -> array
    let copy = []
    for item in arr
        copy.push(item)
    end
    return sample_shuffle(rng, copy)
end

## Returns count randomly sampled distinct elements from arr without replacement.
pub function sample_sample(rng, arr, count) -> array
    let n = len(arr)
    if count <= 0 or n == 0
        return []
    end
    if count >= n
        return sample_shuffled(rng, arr)
    end
    let pool = sample_shuffled(rng, arr)
    let pool_len = len(pool)
    let limit = if count < pool_len then count else pool_len
    let res = []
    let i = 0
    while i < limit
        res.push(pool[i])
        i += 1
    end
    return res
end

## Returns count elements chosen randomly from arr with replacement.
pub function sample_choices(rng, arr, count) -> array
    let n = len(arr)
    if count <= 0 or n == 0
        return []
    end
    let res = []
    let i = 0
    while i < count
        res.push(sample_choice(rng, arr))
        i += 1
    end
    return res
end

## Returns an item chosen randomly according to relative non-negative weights using roulette selection.
pub function sample_weighted_choice(rng, items, weights)
    let n = len(items)
    if n == 0
        return null
    end
    let w_len = len(weights)
    if w_len < n
        return sample_choice(rng, items)
    end

    let total_weight = 0
    for w in weights
        if w > 0
            total_weight += w
        end
    end

    if total_weight <= 0
        return sample_choice(rng, items)
    end

    let threshold = dist_uniform_int(rng, 1, total_weight)
    let accum = 0
    let i = 0
    while i < n
        let w = weights[i]
        if w > 0
            accum += w
            if threshold <= accum
                return items[i]
            end
        end
        i += 1
    end

    return items[0]
end
