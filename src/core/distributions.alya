## # rand/distributions
##
## Statistical distributions for the rand package.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./algorithms.alya"

## Generates a pseudo-random integer in the inclusive range [min_val, max_val].
pub function dist_uniform_int(rng: Rng, min_val: int, max_val: int) -> int
    if min_val >= max_val
        return min_val
    end
    let r = rng_next(rng)
    if r < 0
        r = 0 - r
    end
    let range = (max_val - min_val) + 1
    let rem = r % range
    if rem < 0
        rem = 0 - rem
    end
    let res = min_val + rem
    if res > max_val
        res = max_val
    end
    return res
end

## Generates a pseudo-random float in the half-open range [0.0, 1.0).
pub function dist_float(rng: Rng) -> float
    let r = rng_next(rng) % 1000000000
    return r / 1000000000.0
end

## Generates a pseudo-random float in the half-open range [min_val, max_val).
pub function dist_uniform_float(rng: Rng, min_val, max_val) -> float
    if min_val >= max_val
        return min_val
    end
    let f = dist_float(rng)
    return min_val + (f * (max_val - min_val))
end

## Returns 1 with probability p (0.0 <= p <= 1.0), else 0.
pub function dist_bernoulli(rng: Rng, p) -> int
    if p <= 0.0
        return 0
    end
    if p >= 1.0
        return 1
    end
    let sample = dist_float(rng)
    if sample < p
        return 1
    else
        return 0
    end
end

## Simulates n independent Bernoulli trials with success probability p.
pub function dist_binomial(rng: Rng, n: int, p) -> int
    if n <= 0 or p <= 0.0
        return 0
    end
    let successes = 0
    let i = 0
    while i < n
        successes += dist_bernoulli(rng, p)
        i += 1
    end
    return successes
end

## Returns 1 if an event with probability pct (0..100) occurs, else 0.
pub function dist_chance(rng: Rng, pct: int) -> int
    if pct <= 0
        return 0
    end
    if pct >= 100
        return 1
    end
    return (rng_next(rng) % 100) < pct
end

## Generates a normally distributed random float (Gaussian) using Box-Muller transform.
pub function dist_normal(rng: Rng, mean = 0.0, std_dev = 1.0) -> float
    let r1 = rng_next(rng) % 1000000000
    if r1 <= 0
        r1 = 1
    end
    let u1 = r1 / 1000000000.0

    let r2 = rng_next(rng) % 1000000000
    let u2 = r2 / 1000000000.0
    let two_pi = 6.283185307179586

    let r = native_sqrt(0.0 - 2.0 * native_log(u1))
    let theta = two_pi * u2
    let z0 = r * native_cos(theta)
    return mean + (z0 * std_dev)
end

## Generates an exponentially distributed random float with given rate (lambda).
pub function dist_exponential(rng: Rng, rate = 1.0) -> float
    if rate <= 0.0
        return 0.0
    end
    let r = rng_next(rng) % 1000000000
    if r <= 0
        r = 1
    end
    let u = r / 1000000000.0
    return (0.0 - native_log(1.0 - u)) / (rate * 1.0)
end

## Simulates rolling an n-sided die (returns an integer in 1..sides).
pub function dist_die_roll(rng: Rng, sides: int = 6) -> int
    if sides <= 1
        return 1
    end
    return dist_uniform_int(rng, 1, sides)
end
